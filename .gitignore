# Repo root is Project_git/; the Quartus project lives in Parent/fpga_cnn/,
# so directory rules are anchored with that prefix. Extension globs are left
# unanchored so they match wherever Quartus drops them.

# ---------------- Quartus Prime - generated dirs ----------------
Parent/fpga_cnn/db/
Parent/fpga_cnn/incremental_db/
Parent/fpga_cnn/greybox_tmp/
Parent/fpga_cnn/timing/
Parent/fpga_cnn/.qsys_edit/
Parent/fpga_cnn/qsys_edit.tcl

# Quartus output dir - drop artifacts, keep any HDL source placed there
Parent/fpga_cnn/output_files/*
!Parent/fpga_cnn/output_files/*.v
!Parent/fpga_cnn/output_files/*.sv
!Parent/fpga_cnn/output_files/*.vhd
!Parent/fpga_cnn/output_files/*.vhdl

# ---------------- Qsys / Platform Designer / SoC ----------------
Parent/fpga_cnn/hps_isw_handoff/
Parent/fpga_cnn/ip_upgrade_port_diff_reports/

# IP / PLL simulation model output (matches at any depth)
*_sim/
*_sim.f
simulation/

# ---------------- Quartus - generated files (any depth) ----------------
*.rpt
*.summary
*.smsg
*.pin
*.done
*.jdi
*.jditmp
*.sld
*.cdf
*.qws
*.qarlog
*.ipregen.rpt
c5_pin_model_dump.txt
PLLJ_PLLSPE_INFO.txt

# Programming / bitstream outputs
*.sof
*.pof
*.jam
*.jbc
*.rbf
*.jic
*.svf

# ---------------- Editor / OS / backups ----------------
*.bak
*.BAK
*.BAK.qsys
*.orig
*.*-bak
*~
.DS_Store
Thumbs.db

# ---------------- pre-existing u-boot / BSP workarounds ----------------
