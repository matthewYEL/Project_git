#include <stdio.h>
#include "socal.h"
#include "hps_0_arm_a9_0.h"

int __auto_semihosting;

#define CAMERA_TRIGGER_PIO_BASE  (0xFF200000)
#define SNAPSHOT_DATA_PIO_BASE   (0xFF200010)
#define SNAPSHOT_ADDR_PIO_BASE   (0xFF200020)

int main(int argc, char** argv)
{
    int i, j;
    unsigned int val;
    int pixels[784];

    printf("Triggering camera capture...\n");

    // 触发拍照：写1再写0
    alt_write_word(CAMERA_TRIGGER_PIO_BASE, 1);
    alt_write_word(CAMERA_TRIGGER_PIO_BASE, 0);

    // 简单延时，等待一帧完成+复制784个数据
    // (784周期在VGA_CLK 25MHz下约31微秒，但HPS这边我们保守多等一会儿，
    //  比如等待几十毫秒，确保新一帧真的开始并完成)
    for (volatile int d = 0; d < 5000000; d++);

    printf("Reading 28x28 snapshot...\n");

    // 逐个地址读取784个像素值
    for (i = 0; i < 784; i++) {
        alt_write_word(SNAPSHOT_ADDR_PIO_BASE, i);
        // 读端口是同步的，稍微等一下让地址生效
        for (volatile int d = 0; d < 10; d++);
        val = alt_read_word(SNAPSHOT_DATA_PIO_BASE);
        pixels[i] = (short)(val & 0xFFFF);  // 转回有符号16位
    }

    // 打印成28x28的ASCII字符画
    printf("\n");
    for (i = 0; i < 28; i++) {
        for (j = 0; j < 28; j++) {
            int p = pixels[i*28 + j];
            char c;
            if (p < 500)       c = '.';
            else if (p < 1500) c = '-';
            else if (p < 2500) c = '+';
            else if (p < 3500) c = '#';
            else               c = '@';
            printf("%c", c);
        }
        printf("\n");
    }

    return 0;
}
